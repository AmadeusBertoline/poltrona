# Copie este arquivo para ".env" e preencha. NUNCA commite o ".env".
# Gere o JWT_SECRET com:  openssl rand -hex 32

# --- Aplicação ---
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-64-caracteres
JWT_EXPIRATION=3600000

# --- Banco (execução local sem Docker) ---
DB_URL=jdbc:mysql://localhost:3306/poltrona_db
DB_USERNAME=root
DB_PASSWORD=troque-esta-senha

